/* Resources of Ascension-R.exe: the manifest (gowa.manifest), the icon (app.ico, scripts/brand/brand.py; its windows
 * take it as resource 1) and the version in the file's properties. */
#include <windows.h>
#include "version.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "gowa.manifest"
1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION AR_VERSION_RC
PRODUCTVERSION AR_VERSION_RC
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Ascension-R"
            VALUE "FileVersion", AR_VERSION
            VALUE "OriginalFilename", "Ascension-R.exe"
            VALUE "ProductName", "Ascension-R"
            VALUE "ProductVersion", AR_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
