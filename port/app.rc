/* Resources of Ascension-R.exe: the manifest (gowa.manifest), the version in the file's properties, and the
 * pictures of the precompile screen (loading_screen.cpp), as CMakeLists.txt lists those port/art has in
 * loading_art.rc: none in a tree without them. */
#include <windows.h>
#include "version.h"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "gowa.manifest"

#include "loading_art.rc"

VS_VERSION_INFO VERSIONINFO
FILEVERSION AR_VERSION_RC
PRODUCTVERSION AR_VERSION_RC
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Ascension-R"
            VALUE "FileVersion", AR_VERSION
            VALUE "OriginalFilename", "Ascension-R.exe"
            VALUE "ProductName", "Ascension-R"
            VALUE "ProductVersion", AR_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
